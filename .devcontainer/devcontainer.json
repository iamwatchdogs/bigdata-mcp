{
  "name": "bigdata-mcp",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/.devcontainer/.venv",
    "UV_CACHE_DIR": "${containerWorkspaceFolder}/.devcontainer/.uv_cache",
    "UV_LINK_MODE": "copy",
    "UV_COMPILE_BYTECODE": "1"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/.devcontainer/.venv/bin"
  },
  "mounts": [
    "source=uv-cache-${devcontainerId},target=${containerWorkspaceFolder}/.devcontainer/.uv_cache,type=volume",
    "source=venv-${devcontainerId},target=${containerWorkspaceFolder}/.devcontainer/.venv,type=volume",
    "source=prek-${devcontainerId},target=/home/vscode/.cache/prek,type=volume"
  ],
  "postCreateCommand": "sudo chown -R \"$(whoami)\" \"${containerWorkspaceFolder}/.devcontainer/.venv\" \"${containerWorkspaceFolder}/.devcontainer/.uv_cache\" && make install && { make codacy-install || echo 'warning: make codacy-install failed, so the Codacy analyzers are absent; see .devcontainer/README.md'; } && prek install --install-hooks"
}
